@model Proyecto_De_Reserva_de_boletosMar.DTOs.ViajeDto
@{
    ViewData["Title"] = "Programar viaje";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold text-primary">Programar nuevo viaje</h2>
        <p class="text-muted">Completa los datos para registrar un viaje.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="RutaId" class="form-label fw-semibold">
                        Ruta
                    </label>
                    <select asp-for="RutaId"
                            asp-items="ViewBag.Rutas"
                            class="form-select">
                        <option value="">Seleccione una ruta</option>
                    </select>
                    <span asp-validation-for="RutaId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PangaId" class="form-label fw-semibold">
                        Panga
                    </label>
                    <select asp-for="PangaId"
                            asp-items="ViewBag.Pangas"
                            class="form-select">
                        <option value="">Seleccione una panga</option>
                    </select>
                    <span asp-validation-for="PangaId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaSalida"
                           class="form-label fw-semibold">
                        Fecha y hora de salida
                    </label>
                    <input asp-for="FechaSalida"
                           type="datetime-local"
                           class="form-control"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="FechaSalida"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Observaciones"
                           class="form-label fw-semibold">
                        Observaciones
                    </label>
                    <textarea asp-for="Observaciones"
                              class="form-control"
                              rows="3"
                              maxlength="250"
                              placeholder="Información adicional del viaje (opcional)"></textarea>
                    <span asp-validation-for="Observaciones"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Programar viaje
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


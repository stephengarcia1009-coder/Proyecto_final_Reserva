@model Proyecto_De_Reserva_de_boletosMar.Models.Viaje

@{
    ViewData["Title"] = "Detalles del viaje";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold text-primary">Detalles del viaje</h2>
        <p class="text-muted">Información completa del viaje programado.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-4">ID del viaje</dt>
                <dd class="col-sm-8">@Model.ViajeId</dd>

                <dt class="col-sm-4">Ruta</dt>
                <dd class="col-sm-8">
                    @(Model.Ruta?.Descripcion ?? $"Ruta #{Model.RutaId}")
                </dd>

                <dt class="col-sm-4">Panga</dt>
                <dd class="col-sm-8">
                    @(Model.Panga?.Nombre ?? $"Panga #{Model.PangaId}")
                </dd>

                <dt class="col-sm-4">Fecha de salida</dt>
                <dd class="col-sm-8">
                    @Model.FechaSalida.ToString("dd/MM/yyyy HH:mm")
                </dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">
                    @if (Model.EstadoViajeId == 1)
                    {
                        <span class="badge bg-success">Disponible</span>
                    }
                    else if (Model.EstadoViajeId == 2)
                    {
                        <span class="badge bg-danger">Cancelado</span>
                    }
                    else
                    {
                        @(Model.EstadoViaje?.Nombre ?? "Otro estado")
                    }
                </dd>

                <dt class="col-sm-4">Observaciones</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.Observaciones)
                                        ? "Sin observaciones"
                                        : Model.Observaciones)
                </dd>
            </dl>

            <div class="mt-4 d-flex gap-2">
                @if (Model.EstadoViajeId == 1)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.ViajeId"
                       class="btn btn-primary">
                        Editar viaje
                    </a>
                }

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Volver
                </a>
            </div>
        </div>
    </div>
</div>


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sistema de Reservas Marítimas</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proyecto_De_Reserva_de_boletosMar.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    SISTEMA DE RESERVAS MARÍTIMAS
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menuPrincipal">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Inicio
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown">
                                        Administración
                                    </a>

                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Destinos"
                                               asp-action="Index">
                                                Destinos
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Rutas"
                                               asp-action="Index">
                                                Rutas
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Pangas"
                                               asp-action="Index">
                                                Pangas
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Tarifas"
                                               asp-action="Index">
                                                Tarifas
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Viajes"
                                               asp-action="Index">
                                                Viajes
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider" /></li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Reservas"
                                               asp-action="Index">
                                                Gestión de reservas
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider" /></li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Usuarios"
                                               asp-action="Index">
                                                Gestión de usuarios
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else if (User.IsInRole("Cliente"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Reservas"
                                       asp-action="SeleccionarViaje">
                                        Reservar boletos
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Reservas"
                                       asp-action="MisReservas">
                                        Mis reservas
                                    </a>
                                </li>
                            }

                            <li class="nav-item ms-lg-2">
                                <form asp-controller="Auth"
                                      asp-action="Logout"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-light btn-sm">
                                        Cerrar sesión
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Auth"
                                   asp-action="Login">
                                    Iniciar sesión
                                </a>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-light btn-sm"
                                   asp-controller="Auth"
                                   asp-action="Registro">
                                    Registrarse
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container py-4">
        @RenderBody()
    </main>

    <footer class="border-top bg-light py-3 mt-4">
        <div class="container text-center text-muted">
            <p class="mb-1">
                &copy; 2026 - Sistema de Reservas Marítimas
            </p>
            <small>Servicio de transporte marítimo y reserva de boletos.</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

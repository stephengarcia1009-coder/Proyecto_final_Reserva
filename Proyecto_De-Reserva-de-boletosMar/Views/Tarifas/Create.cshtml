@model Proyecto_De_Reserva_de_boletosMar.Models.Tarifa

@{
    ViewData["Title"] = "Nueva tarifa";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold text-primary">Registrar nueva tarifa</h2>
        <p class="text-muted">Ingresa la ruta y el precio correspondiente.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="RutaId" class="form-label fw-semibold">
                        ID de la ruta
                    </label>
                    <input asp-for="RutaId"
                           type="number"
                           class="form-control"
                           min="1"
                           placeholder="Ingresa el ID de la ruta" />
                    <span asp-validation-for="RutaId"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Precio" class="form-label fw-semibold">
                        Precio de la tarifa
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">C$</span>
                        <input asp-for="Precio"
                               type="number"
                               class="form-control"
                               min="0.01"
                               max="1000000"
                               step="0.01"
                               placeholder="Ej. 250.00" />
                    </div>
                    <span asp-validation-for="Precio"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Registrar tarifa
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

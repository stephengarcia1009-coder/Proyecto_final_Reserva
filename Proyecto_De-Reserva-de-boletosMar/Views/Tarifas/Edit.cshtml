@model Proyecto_De_Reserva_de_boletosMar.DTOs.TarifaDto

@{
    ViewData["Title"] = "Editar tarifa";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold text-primary">Actualizar tarifa</h2>
        <p class="text-muted">
            Modifica el precio de la tarifa seleccionada.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Edit"
                  asp-route-id="@Model.TarifaId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <input type="hidden" asp-for="TarifaId" />
                <input type="hidden" asp-for="RutaId" />

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        ID de tarifa
                    </label>
                    <input value="@Model.TarifaId"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Ruta
                    </label>
                    <input value="@ViewBag.NombreRuta"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Precio"
                           class="form-label fw-semibold">
                        Nuevo precio
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">C$</span>
                        <input asp-for="Precio"
                               type="number"
                               class="form-control"
                               min="0.01"
                               max="1000000"
                               step="0.01"
                               required />
                    </div>

                    <span asp-validation-for="Precio"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Guardar cambios
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

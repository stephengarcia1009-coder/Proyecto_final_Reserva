@model IEnumerable<Proyecto_De_Reserva_de_boletosMar.Models.Tarifa>

@{
    ViewData["Title"] = "Tarifas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary">Gestión de tarifas</h2>
            <p class="text-muted">Consulta y administra las tarifas de las rutas.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nueva tarifa
        </a>
    </div>

    @if (TempData["ErrorTarifa"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorTarifa"]
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>ID</th>
                            <th>Ruta</th>
                            <th>Precio</th>
                            <th>Última actualización</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var tarifa in Model)
                            {
                                <tr>
                                    <td>@tarifa.TarifaId</td>
                                    <td>Ruta #@tarifa.RutaId</td>
                                    <td>C$ @tarifa.Precio.ToString("N2")</td>
                                    <td>@tarifa.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <a asp-action="Details"
                                           asp-route-id="@tarifa.TarifaId"
                                           class="btn btn-sm btn-outline-info">
                                            Ver
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@tarifa.TarifaId"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    No hay tarifas registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

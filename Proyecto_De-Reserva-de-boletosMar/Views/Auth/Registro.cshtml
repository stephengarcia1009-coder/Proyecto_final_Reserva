@model Proyecto_De_Reserva_de_boletosMar.ViewModels.RegistroViewModel

@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4">

            <div class="card-header bg-primary text-white text-center py-4">
                <h2 class="fw-bold mb-1">Crear cuenta</h2>
                <p class="mb-0">Sistema de Reservas Marítimas</p>
            </div>

            <div class="card-body p-4 p-md-5">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <form asp-controller="Auth"
                      asp-action="Registro"
                      method="post">

                    <div class="mb-3">
                        <label asp-for="NombreCompleto" class="form-label fw-semibold">
                            Nombre completo
                        </label>
                        <input asp-for="NombreCompleto"
                               class="form-control"
                               placeholder="Ingresa tu nombre completo" />
                        <span asp-validation-for="NombreCompleto"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold">
                            Correo electrónico
                        </label>
                        <input asp-for="Correo"
                               class="form-control"
                               placeholder="ejemplo@correo.com" />
                        <span asp-validation-for="Correo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label fw-semibold">
                            Teléfono
                        </label>
                        <input asp-for="Telefono"
                               class="form-control"
                               placeholder="Ingresa tu teléfono" />
                        <span asp-validation-for="Telefono"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">
                            Contraseña
                        </label>
                        <input asp-for="Password"
                               class="form-control"
                               placeholder="Mínimo 6 caracteres" />
                        <span asp-validation-for="Password"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarPassword" class="form-label fw-semibold">
                            Confirmar contraseña
                        </label>
                        <input asp-for="ConfirmarPassword"
                               class="form-control"
                               placeholder="Repite tu contraseña" />
                        <span asp-validation-for="ConfirmarPassword"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary btn-lg w-100 fw-semibold">
                        Crear cuenta
                    </button>

                </form>

                <div class="text-center mt-4">
                    <span class="text-muted">¿Ya tienes una cuenta?</span>
                    <a asp-controller="Auth"
                       asp-action="Login"
                       class="fw-semibold text-decoration-none">
                        Inicia sesión
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

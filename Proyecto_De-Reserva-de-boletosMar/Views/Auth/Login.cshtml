@model Proyecto_De_Reserva_de_boletosMar.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-7 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4">
            <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                <h2 class="fw-bold mb-1">Bienvenido</h2>
                <p class="mb-0">Sistema de Reservas Marítimas</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <h4 class="text-center fw-bold mb-4">Iniciar sesión</h4>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <form asp-controller="Auth"
                      asp-action="Login"
                      method="post">

                    <div class="mb-3">
                        <label asp-for="Correo" class="form-label fw-semibold">
                            Correo electrónico
                        </label>
                        <input asp-for="Correo"
                               class="form-control form-control-lg"
                               placeholder="ejemplo@correo.com" />
                        <span asp-validation-for="Correo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">
                            Contraseña
                        </label>
                        <input asp-for="Password"
                               class="form-control form-control-lg"
                               placeholder="Ingresa tu contraseña" />
                        <span asp-validation-for="Password"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Recordar" class="form-check-input" />
                        <label asp-for="Recordar" class="form-check-label">
                            Recordarme
                        </label>
                    </div>

                    <button type="submit"
                            class="btn btn-primary btn-lg w-100 fw-semibold">
                        Iniciar sesión
                    </button>
                </form>

                <div class="text-center mt-4">
                    <span class="text-muted">¿No tienes una cuenta?</span>
                    <a asp-controller="Auth"
                       asp-action="Registro"
                       class="fw-semibold text-decoration-none">
                        Regístrate aquí
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@using Proyecto_De_Reserva_de_boletosMar.Constants
@model Proyecto_De_Reserva_de_boletosMar.ViewModels.UsuariosGestionViewModel

@{
    ViewData["Title"] = "Gestión de usuarios";
}

<div class="container mt-4">
    <h2>Gestión de usuarios</h2>
    <p>Administra los roles y permisos de los usuarios registrados.</p>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @foreach (var usuario in Model.Usuarios)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5>@usuario.Email</h5>

                <hr />

                <h6>Roles asignados</h6>

                @if (usuario.Roles.Any())
                {
                    @foreach (var rol in usuario.Roles)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-primary">@rol</span>

                            <form asp-action="QuitarRol" method="post">
                                <input type="hidden" name="usuarioId" value="@usuario.Id" />
                                <input type="hidden" name="rol" value="@rol" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Quitar rol
                                </button>
                            </form>
                        </div>
                    }
                }
                else
                {
                    <p>No tiene roles asignados.</p>
                }

                <form asp-action="AsignarRol" method="post" class="mt-3">
                    <input type="hidden" name="usuarioId" value="@usuario.Id" />

                    <div class="input-group">
                        <select name="rol" class="form-select" required>
                            <option value="">Seleccionar rol</option>
                            @foreach (var rol in Model.RolesDisponibles.Except(usuario.Roles))
                            {
                                <option value="@rol">@rol</option>
                            }
                        </select>

                        <button type="submit" class="btn btn-primary">
                            Asignar rol
                        </button>
                    </div>
                </form>

                <hr />

                <h6>Permisos asignados</h6>

                @if (usuario.Permisos.Any())
                {
                    @foreach (var permiso in usuario.Permisos)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span>@permiso</span>

                            <form asp-action="QuitarPermiso" method="post">
                                <input type="hidden" name="usuarioId" value="@usuario.Id" />
                                <input type="hidden" name="permiso" value="@permiso" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Quitar permiso
                                </button>
                            </form>
                        </div>
                    }
                }
                else
                {
                    <p>No tiene permisos individuales asignados.</p>
                }

              <form asp-action="AsignarPermiso" method="post" class="mt-3">
    <input type="hidden" name="usuarioId" value="@usuario.Id" />

    <div class="input-group">
        <select name="permiso" class="form-select" required>
            <option value="">Seleccionar permiso</option>

            @foreach (var permiso in PermisosSistema.Todos.Except(usuario.Permisos))
            {
                <option value="@permiso">@permiso</option>
            }
        </select>

        <button type="submit" class="btn btn-success">
            Asignar permiso
        </button>
    </div>
</form>
            </div>
        </div>
    }

    <hr class="my-4" />

    <h3>Gestión de permisos por roles</h3>
    <p>Asigna o retira permisos a los roles disponibles del sistema.</p>

    @foreach (var rol in Model.RolesGestion)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5>@rol.Nombre</h5>

                <h6 class="mt-3">Permisos asignados</h6>

                @if (rol.Permisos.Any())
                {
                    @foreach (var permiso in rol.Permisos)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-primary">@permiso</span>

                            <form asp-action="QuitarPermisoRol" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="rolId" value="@rol.Id" />
                                <input type="hidden" name="permiso" value="@permiso" />

                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Quitar permiso
                                </button>
                            </form>
                        </div>
                    }
                }
                else
                {
                    <p>Este rol no tiene permisos adicionales asignados.</p>
                }

                <form asp-action="AsignarPermisoRol" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rolId" value="@rol.Id" />

                    <div class="input-group">
                        <select name="permiso" class="form-select" required>
                            <option value="">Seleccionar permiso</option>

                            @foreach (var permiso in PermisosSistema.Todos.Except(rol.Permisos))
                            {
                                <option value="@permiso">@permiso</option>
                            }
                        </select>

                        <button type="submit" class="btn btn-success">
                            Asignar permiso
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }



</div>

@model Proyecto_De_Reserva_de_boletosMar.Models.Panga

@{
    ViewData["Title"] = "Detalles de la panga";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Detalles de la panga</h4>
                </div>

                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Código</dt>
                        <dd class="col-sm-8">@Model.PangaId</dd>

                        <dt class="col-sm-4">Nombre</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>

                        <dt class="col-sm-4">Capacidad</dt>
                        <dd class="col-sm-8">@Model.Capacidad pasajeros</dd>

                        <dt class="col-sm-4">Descripción</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Descripcion)
                                                        ? "Sin descripción"
                                                        : Model.Descripcion)
                        </dd>
                    </dl>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Volver
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model.PangaId"
                           class="btn btn-primary">
                            Editar panga
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

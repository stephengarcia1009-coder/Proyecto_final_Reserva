@model Proyecto_De_Reserva_de_boletosMar.ViewModels.ReservaPresencialViewModel
@using Proyecto_De_Reserva_de_boletosMar.Models

@{
    ViewData["Title"] = "Registrar reserva presencial";
    var clientes = ViewBag.Clientes as IEnumerable<Cliente>;
    var viajes = ViewBag.Viajes as IEnumerable<Viaje>;
}

<h2>Registrar reserva presencial</h2>

<form asp-action="CrearPresencial" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ClienteId" class="form-label">Cliente</label>
        <select asp-for="ClienteId" class="form-select">
            <option value="">Seleccione un cliente</option>
            @if (clientes != null)
            {
                foreach (var cliente in clientes)
                {
                    <option value="@cliente.ClienteId">
                        @cliente.NombreCompleto - @cliente.Correo
                    </option>
                }
            }
        </select>
        <span asp-validation-for="ClienteId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ViajeId" class="form-label">Viaje</label>
        <select asp-for="ViajeId" class="form-select">
            <option value="">Seleccione un viaje</option>
            @if (viajes != null)
            {
                foreach (var viaje in viajes)
                {
                    <option value="@viaje.ViajeId">
                        @(viaje.Ruta?.Descripcion ?? $"Ruta #{viaje.RutaId}") |
                        @viaje.FechaSalida.ToString("dd/MM/yyyy HH:mm") |
                        @(viaje.Panga?.Nombre ?? $"Panga #{viaje.PangaId}")
                    </option>
                }
            }
        </select>
        <span asp-validation-for="ViajeId" class="text-danger"></span>
    </div>

    <h4>Datos de los pasajeros</h4>

    <div id="pasajeros">
        @for (int i = 0; i < Model.Pasajeros.Count; i++)
        {
            <div class="border rounded p-3 mb-3 pasajero">
                <h5>Pasajero @(i + 1)</h5>

                <div class="mb-3">
                    <label class="form-label">Nombre completo</label>
                    <input asp-for="Pasajeros[i].NombrePasajero"
                           class="form-control" />
                    <span asp-validation-for="Pasajeros[i].NombrePasajero"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <input asp-for="Pasajeros[i].TelefonoPasajero"
                           class="form-control" />
                    <span asp-validation-for="Pasajeros[i].TelefonoPasajero"
                          class="text-danger"></span>
                </div>
            </div>
        }
    </div>

    <button type="button" id="agregarPasajero" class="btn btn-secondary">
        Agregar pasajero
    </button>

    <button type="submit" class="btn btn-primary">
        Registrar reserva
    </button>

    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let contador = @Model.Pasajeros.Count;

        document.getElementById("agregarPasajero")
            .addEventListener("click", function () {

                const contenedor = document.getElementById("pasajeros");

                const div = document.createElement("div");
                div.className = "border rounded p-3 mb-3 pasajero";

                div.innerHTML = `
                    <h5>Pasajero ${contador + 1}</h5>

                    <div class="mb-3">
                        <label class="form-label">Nombre completo</label>
                        <input name="Pasajeros[${contador}].NombrePasajero"
                               class="form-control" required maxlength="150" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Teléfono</label>
                        <input name="Pasajeros[${contador}].TelefonoPasajero"
                               class="form-control" required maxlength="20" />
                    </div>

                    <button type="button"
                            class="btn btn-danger btn-sm eliminar">
                        Quitar pasajero
                    </button>
                `;

                contenedor.appendChild(div);

                contador++;
            });

               document.getElementById("pasajeros")
            .addEventListener("click", function (e) {
                if (e.target.classList.contains("eliminar")) {
                    e.target.closest(".pasajero").remove();
                }
            });

        document.querySelector("form")
            .addEventListener("submit", function () {

                const pasajeros = document.querySelectorAll(
                    "#pasajeros .pasajero"
                );

                pasajeros.forEach((pasajero, index) => {

                    pasajero.querySelector("h5").textContent =
                        `Pasajero ${index + 1}`;

                    const inputs = pasajero.querySelectorAll("input");

                    inputs[0].name =
                        `Pasajeros[${index}].NombrePasajero`;

                    inputs[1].name =
                        `Pasajeros[${index}].TelefonoPasajero`;
                });
            });
    </script>
}

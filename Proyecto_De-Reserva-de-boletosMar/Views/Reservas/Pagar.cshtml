
@model Proyecto_De_Reserva_de_boletosMar.Models.Reserva

@{
    ViewData["Title"] = "Simular pago";
}

<h2>Confirmar reserva y simular pago</h2>

<div class="card p-4 mt-3">
    <h4>Resumen de tu reserva</h4>

    <p><strong>Código:</strong> @Model.CodigoReserva</p>
    <p><strong>Cantidad de boletos:</strong> @Model.CantidadBoletos</p>
    <p><strong>Total a pagar:</strong> @Model.Total.ToString("C")</p>

    <hr />

    <h5>Selecciona un escenario de pago</h5>

    <p>
        Esta es una simulación académica. No se solicitarán
        datos bancarios ni información de tarjetas.
    </p>

    <div class="d-flex gap-3 flex-wrap mt-3">

        <form asp-controller="Reservas"
              asp-action="ProcesarPago"
              method="post">

              @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.ReservaId" />
            <input type="hidden" name="pagoExitoso" value="true" />

            <button type="submit" class="btn btn-success">
                Simular pago exitoso
            </button>
        </form>

        <form asp-controller="Reservas"
              asp-action="ProcesarPago"
              method="post">

              @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.ReservaId" />
            <input type="hidden" name="pagoExitoso" value="false" />

            <button type="submit" class="btn btn-danger">
                Simular pago rechazado
            </button>
        </form>

    </div>
</div>

@model IEnumerable<Proyecto_De_Reserva_de_boletosMar.Models.Viaje>

@{
    ViewData["Title"] = "Seleccionar viaje";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold">Viajes disponibles</h2>
        <p class="text-muted">Selecciona el viaje que deseas reservar.</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="SeleccionarViaje" method="get">
                <div class="row align-items-end">
                    <div class="col-md-6 mb-3 mb-md-0">
                        <label for="fecha" class="form-label">Fecha del viaje</label>
                        <input type="date"
                               id="fecha"
                               name="fecha"
                               value="@ViewBag.FechaConsulta"
                               class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            Buscar viajes
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var viaje in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <span class="badge bg-success mb-3">
                                Disponible
                            </span>

                            <h5 class="card-title fw-bold">
                                @(viaje.Ruta?.Descripcion ?? $"Ruta #{viaje.RutaId}")
                            </h5>

                            <p class="mb-2">
                                <strong>Fecha:</strong>
                                @viaje.FechaSalida.ToString("dd/MM/yyyy")
                            </p>

                            <p class="mb-2">
                                <strong>Hora:</strong>
                                @viaje.FechaSalida.ToString("hh:mm tt")
                            </p>

                            <p class="mb-2">
                                <strong>Panga:</strong>
                                @(viaje.Panga?.Nombre ?? $"Panga #{viaje.PangaId}")
                            </p>

                            @if (viaje.Panga != null)
                            {
                                <p class="mb-3">
                                    <strong>Capacidad:</strong>
                                    @viaje.Panga.Capacidad pasajeros
                                </p>
                            }

                            <a asp-action="Crear"
                               asp-route-viajeId="@viaje.ViajeId"
                               class="btn btn-primary w-100">
                                Seleccionar viaje
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            No hay viajes disponibles para la fecha seleccionada.
        </div>
    }
</div>


@model IEnumerable<Proyecto_De_Reserva_de_boletosMar.Models.Destino>

@{
    ViewData["Title"] = "Gestión de destinos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-primary">Gestión de destinos</h2>
        <p class="text-muted mb-0">Administra los destinos disponibles para los viajes.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary mt-3 mt-md-0">
        <i class="bi bi-plus-circle me-1"></i> Nuevo destino
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var destino in Model)
                        {
                            <tr>
                                <td>@destino.DestinoId</td>
                                <td class="fw-semibold">@destino.Nombre</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(destino.Descripcion)
                                                                ? "Sin descripción"
                                                                : destino.Descripcion)
                        </td>
                        <td>
                            @if (destino.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center flex-wrap gap-2">
                                        <a asp-action="Details"
                                           asp-route-id="@destino.DestinoId"
                                           class="btn btn-sm btn-outline-info">
                                            Ver
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@destino.DestinoId"
                                           class="btn btn-sm btn-outline-primary">
                                            Editar
                                        </a>

                                        <form asp-action="CambiarEstado"
                                              asp-route-id="@destino.DestinoId"
                                              method="post">
                                            <button type="submit"
                                                    class="btn btn-sm @(destino.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                                @(destino.Activo ? "Desactivar" : "Activar")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5 class="text-muted">No hay destinos registrados.</h5>
                <p class="text-muted">Puedes comenzar agregando un nuevo destino.</p>
                <a asp-action="Create" class="btn btn-primary">
                    Registrar destino
                </a>
            </div>
        }
    </div>
</div>

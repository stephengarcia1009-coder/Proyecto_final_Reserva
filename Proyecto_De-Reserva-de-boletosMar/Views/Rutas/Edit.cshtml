@model Proyecto_De_Reserva_de_boletosMar.DTOs.RutaDto

@{
    ViewData["Title"] = "Editar ruta";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">

        <div class="mb-4">
            <h2 class="fw-bold text-primary">Editar ruta</h2>
            <p class="text-muted">
                Modifica la información de la ruta seleccionada.
            </p>
        </div>

        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">

                <form asp-action="Edit"
                      asp-route-id="@Model.RutaId"
                      method="post">

                    <input type="hidden" asp-for="RutaId" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="OrigenId"
                               class="form-label fw-semibold">
                            Destino de origen
                        </label>

                        <select asp-for="OrigenId"
                                asp-items="ViewBag.Destinos"
                                class="form-select">
                            <option value="">Seleccione el origen</option>
                        </select>

                        <span asp-validation-for="OrigenId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DestinoId"
                               class="form-label fw-semibold">
                            Destino de llegada
                        </label>

                        <select asp-for="DestinoId"
                                asp-items="ViewBag.Destinos"
                                class="form-select">
                            <option value="">Seleccione el destino</option>
                        </select>

                        <span asp-validation-for="DestinoId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion"
                               class="form-label fw-semibold">
                            Descripción
                        </label>

                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="4"></textarea>

                        <span asp-validation-for="Descripcion"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="Activa"
                               class="form-check-input" />

                        <label asp-for="Activa"
                               class="form-check-label">
                            Ruta activa
                        </label>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            Guardar cambios
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
